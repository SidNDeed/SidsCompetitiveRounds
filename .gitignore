# Environments / secrets
.env
.env.*
**/*.key
**/*.pem
**/id_rsa*
**/id_ed25519*

# Build output
bin/
obj/
plugin/bin/
plugin/obj/
installer/bin/
installer/obj/
dist/

# Log captures and one-off drops
logs-snapshot/
*.log

# Tool caches
.vs/
.idea/
.vscode/
*.user
*.userprefs

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Claude Code — KEEP LOCAL ONLY (contains IPs, paths, infra details)
# Claude Code reads these from disk regardless of git tracking.
# Only docs/learnings.md is safe to publish.
CLAUDE.md
SETUP.md
.claude/
docs/deploy-reference.md
scripts/

# NuGet
packages/
*.nupkg

# Python caches (defensive — the backend runs in Docker, no local venv expected)
__pycache__/
*.pyc
.venv/
