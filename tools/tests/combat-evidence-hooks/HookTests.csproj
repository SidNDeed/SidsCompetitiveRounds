<Project Sdk="Microsoft.NET.Sdk">

  <!-- Combat evidence hook harness: compiles the thirteen hook classes
       run_hooks.py copies VERBATIM out of plugin/CombatEvidence.cs
       (HooksSource) against Stubs.cs, where every collector throws. The
       plugin's own csproj is never involved. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CombatHookTests</AssemblyName>
    <RootNamespace>CompetitiveRounds</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Stubs.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Program.cs" />
    <Compile Include="$(HooksSource)" />
  </ItemGroup>

</Project>
