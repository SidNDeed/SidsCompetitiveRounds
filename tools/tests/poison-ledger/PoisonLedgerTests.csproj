<Project Sdk="Microsoft.NET.Sdk">

  <!-- Poison convergence v3 (bugs 406/407): executes the REAL
       plugin/PoisonLedgerCore.cs (life epoch, ledger, catch-up, claims,
       activation). run_tests.py builds it, runs every case, then builds
       mutated COPIES of that file (CoreSource override) and requires each
       mutant's target case to fail and its control to pass. The tracked file
       is never modified. The path is RELATIVE so no local directory lands in
       a tracked file. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PoisonLedgerTests</AssemblyName>
    <RootNamespace>PoisonLedgerTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreSource)' == ''">
    <CoreSource>$(MSBuildThisFileDirectory)..\..\..\plugin\PoisonLedgerCore.cs</CoreSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreSource)" />
    <Compile Include="$(MSBuildThisFileDirectory)Program.cs" />
  </ItemGroup>

</Project>
