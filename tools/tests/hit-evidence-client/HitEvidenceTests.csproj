<Project Sdk="Microsoft.NET.Sdk">

  <!-- Item D (hit / knockback / block evidence): executes the REAL
       plugin/HitEvidenceCore.cs: the pairing of damage and knockback
       messages, the block buckets, the per-projectile first-hit count and the
       three evidence lines. run_tests.py builds it, runs every case, then
       builds mutated COPIES of that file (CoreSource override) and requires
       each mutant's target case to fail and its control to pass. The tracked
       file is never modified. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HitEvidenceTests</AssemblyName>
    <RootNamespace>HitEvidenceTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreSource)' == ''">
    <CoreSource>$(MSBuildThisFileDirectory)..\..\..\plugin\HitEvidenceCore.cs</CoreSource>
  </PropertyGroup>

  <!-- Merge pass 5: the [PEER-BUILD] line's pure half, plugin/PeerBuildCore.cs,
       executed the same way (PeerSource override for its mutants). -->
  <PropertyGroup Condition="'$(PeerSource)' == ''">
    <PeerSource>$(MSBuildThisFileDirectory)..\..\..\plugin\PeerBuildCore.cs</PeerSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreSource)" />
    <Compile Include="$(PeerSource)" />
    <Compile Include="$(MSBuildThisFileDirectory)Program.cs" />
  </ItemGroup>

</Project>
