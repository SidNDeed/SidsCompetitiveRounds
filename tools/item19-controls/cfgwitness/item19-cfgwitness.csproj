<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Item 19 fix pass 1, M10: the config witness. Drives the GAME'S OWN
    BepInEx.dll (BepInExCore is passed by item19_controls.py; nothing here
    names a local path). Copied to a work directory and built there.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>item19-cfgwitness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3277;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CfgWitness.cs" />
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="'$(ManagedDir)' != ''">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="'$(ManagedDir)' != ''">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
