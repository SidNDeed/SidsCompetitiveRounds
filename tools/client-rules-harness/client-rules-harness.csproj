<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EXECUTES the client rule files that are deliberately free of Unity, Photon
    and BepInEx, under a plain compiler. Same arrangement as
    tools/h2h-harness, and for the same reason: a rule whose only gate is a
    source-shape test is asserted ABOUT, never run (#391).

      LogScrub.cs       what a log bundle stops carrying before it leaves the
                        process. Its SelfTest is two-way: every case is
                        measured with the scrub and without it, and a case
                        passes only when the unscrubbed measurement is
                        non-zero.

      TopStripBand.cs   the top-centre column's band allocator: which y each
                        surface gets when several paint at once. It takes the
                        frame number as a PARAMETER precisely so it can be
                        driven from here instead of asserted about.

      FfaReportRules.cs who submits an FFA game's report, what key it is filed
                        under, and whether a refusal is final. The key must be
                        identical on every seat in the room and must still
                        carry the suffix the server parses out of it.

      RosterCensusRules.cs  which seats a per-game roster WIDENING may take in
                        and which rejection latches the resulting roster
                        releases. Both were unrunnable while they lived inside
                        RoomActors against live Photon state, and the r2 HIGH
                        they close — a widening census that had already
                        excluded the actor it was deciding about — is exactly
                        the kind of circularity a source-shape test cannot see.

    net10.0 because that is the runtime installed on the build seat, matching
    the h2h harness; RollForward keeps the next SDK rotation from turning this
    into a green-looking nothing.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>client-rules-harness</AssemblyName>
    <RootNamespace>CompetitiveRounds.Harness</RootNamespace>
    <!-- Only the files named below. A default glob would drag in the whole
         plugin tree, which does not compile without Unity. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.cs" />
    <Compile Include="../../plugin/LogScrub.cs" />
    <Compile Include="../../plugin/TopStripBand.cs" />
    <Compile Include="../../plugin/FfaReportRules.cs" />
    <Compile Include="../../plugin/RosterCensusRules.cs" />
  </ItemGroup>

</Project>
