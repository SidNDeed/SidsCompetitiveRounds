<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CompetitiveRounds</AssemblyName>
    <RootNamespace>CompetitiveRounds</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0169;CS0649</NoWarn>
    <Configurations>Debug;Release;Thunderstore</Configurations>
    <!-- Deterministic, symbol-free output: BepInEx stack traces report IL
         offsets regardless (the pdb is never loaded at runtime), so shipped
         builds carry no debug artifacts. Do not change. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Thunderstore build: excludes auto-updater .bat at compile time -->
  <!-- Build with: dotnet build -c Thunderstore  (or select "Thunderstore" config in VS) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Thunderstore'">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
    <!-- The SDK only turns optimization on for the configuration literally
         named "Release"; a custom configuration defaults to Optimize=false.
         Without this the Thunderstore DLL ships UNOPTIMIZED - caught while
         packaging 1.36.0, when the Thunderstore build came out 133 KB LARGER
         than Release despite compiling strictly less code (the auto-updater is
         #if'd out of it). Every Thunderstore release before this one shipped
         unoptimized IL. Does NOT touch DebugType/Deterministic, which stay
         load-bearing for the no-local-paths guarantee. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <RoundsDir>C:\Program Files (x86)\Steam\steamapps\common\ROUNDS</RoundsDir>
    <BepInExDir>$(RoundsDir)\BepInEx</BepInExDir>
    <ManagedDir>$(RoundsDir)\Rounds_Data\Managed</ManagedDir>
  </PropertyGroup>

  <!-- Krafs.Publicizer — exposes private members of referenced assemblies at compile time -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- BepInEx (still needed for plugin loading and logging) -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InControl">
      <!-- Needed because the InputDevice type appears in the signature of
           PlayerAssigner.CreatePlayer, which we Harmony-patch for 2v2. -->
      <HintPath>$(ManagedDir)\InControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityWebRequestMultimedia + DownloadHandlerAudioClip (streamAudio) —
         the custom music engine streams its OGGs from disk through these.
         Ships with the game; zero distribution cost. -->
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ForceMode2D for the FFA map-scale OutOfBounds replica (FfaMapScale.cs)
         — the enum appears in HealthHandler.CallTakeForce's signature, so the
         string-GetComponent trick can't cover it. Always loaded by the game. -->
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity Post-Processing Stack v2 — used by the custom map color profiles
         (CustomMapColors.cs) so we can author ColorGrading effects at runtime
         without bundling pre-made PostProcessProfile assets. -->
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(ManagedDir)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity.Localization (+ Addressables/ResourceManager for its handle
         types) — the base-game locale injector (GameLocaleInjector.cs,
         localization-design §6.3 v2): ITableProvider's generic method cannot
         be implemented via reflection, so these are plain typed references.
         Game-owned assemblies, public APIs only — NOT publicized. -->
    <Reference Include="Unity.Localization">
      <HintPath>$(ManagedDir)\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(ManagedDir)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(ManagedDir)\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game (publicized for direct access to private members) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <!-- Photon (publicized for direct access to private members) -->
  <ItemGroup>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="PhotonUnityNetworking" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="PhotonRealtime" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <!-- Steamworks -->
  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Auto-copy to plugins folder after build. The font bundle is optional — generated by
       the unity-font-bundler/ Unity project, written to the same OutputPath. If present we
       copy it alongside the DLL so NametagFontRenderer can load it via AssetBundle.LoadFromFile
       next to itself. If absent (user hasn't run the Font Bundler), the mod still loads;
       typefaces just silently fall back to the default font. -->
  <!-- Card art (jpg/png) — shipped alongside the DLL. CardImageLoader.cs
       reads these from <plugin-dir>/cards/ at runtime. The CardArtToCopy
       item group rebuilds on each build to pick up new files. -->
  <ItemGroup>
    <CardArtToCopy Include="cards\*.jpg" />
    <CardArtToCopy Include="cards\*.png" />
    <!-- Custom cosmetic art (512px transparent PNGs) — CustomCosmetics.cs reads
         these from <plugin-dir>/cosmetics/ at runtime (same pipeline as cards). -->
    <CosmeticArtToCopy Include="cosmetics\*.png" />
    <!-- Custom music pack (plugin/music/ is gitignored by name — present only
         on seats holding the masters; empty globs make every copy a no-op
         elsewhere). Dev-loop mirror of the v3 delivery layout: the previews
         tier gets the 30s *_preview.ogg snippets + the cover PNG, the full
         tier gets the full-length OGGs, the mastering manifest.json lands at
         the revision root. NO installed.json marker is emitted here —
         MusicAssets validates dev trees against the COMPILED manifest and
         rewrites the marker itself for a fully-valid marker-less tree
         (agent-A contract; the WriteLinesToFile alternative was rejected
         because the marker format is MusicAssets-owned and a wrong-format
         marker reads as an INVALID tree). -->
    <MusicPreviewsToCopy Include="music\*_preview.ogg" />
    <MusicPreviewsToCopy Include="music\*.png" />
    <MusicFullToCopy Include="music\*.ogg" Exclude="music\*_preview.ogg" />
    <MusicManifestToCopy Include="music\manifest.json" />
  </ItemGroup>

  <!-- Home-tab logo: EMBEDDED in the DLL (not a loose file) because the
       auto-updater ships the DLL alone — a beside-the-DLL asset would vanish
       for auto-updated installs. NativeUI resolves it by manifest-name suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\logo.png" />
    <!-- Footer link-button glyphs (white on transparent; loader matches by
         exact trailing filename, so none of these may end in "logo.png"). -->
    <EmbeddedResource Include="assets\icon_youtube.png" />
    <EmbeddedResource Include="assets\icon_twitch.png" />
    <EmbeddedResource Include="assets\icon_thunderstore.png" />
    <EmbeddedResource Include="assets\icon_discord.png" />
    <EmbeddedResource Include="assets\icon_github.png" />
    <!-- Music transport glyphs (white on transparent, same loader/tinting
         pipeline as the icon_* set): standard player iconography for the
         Music tab's bottom transport bar. "mus_ic_" prefix keeps them out
         of the icon_* footer-button namespace. -->
    <EmbeddedResource Include="assets\mus_ic_play.png" />
    <EmbeddedResource Include="assets\mus_ic_pause.png" />
    <EmbeddedResource Include="assets\mus_ic_prev.png" />
    <EmbeddedResource Include="assets\mus_ic_next.png" />
    <EmbeddedResource Include="assets\mus_ic_shuffle.png" />
    <EmbeddedResource Include="assets\mus_ic_loop.png" />
    <EmbeddedResource Include="assets\mus_ic_volume.png" />
    <EmbeddedResource Include="assets\mus_ic_stop.png" />
  </ItemGroup>

  <!-- SkipCopyToPlugins=true builds WITHOUT installing to the local BepInEx —
       a compile-verify of in-progress work must not live-deploy to this
       machine (every Release build otherwise IS an install; learning #269). -->
  <PropertyGroup>
    <!-- impl-r4 K4: the dev-copy destination derives from the SAME source
         authority runtime compiles (MusicAssets.ASSET_REVISION) - a revision
         bump can no longer strand dev seats copying into a tree the DLL never
         searches. MSBuild property functions parse it straight from source. -->
    <MusicAssetRevision>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\MusicAssets.cs')), 'ASSET_REVISION\s*=\s*&quot;([a-z0-9]+)&quot;').Groups[1].Value)</MusicAssetRevision>
  </PropertyGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(SkipCopyToPlugins)' != 'true'">
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds" />
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\cards" />
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\cosmetics" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)comp-rounds-fonts"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)comp-rounds-fonts')" />
    <Copy SourceFiles="@(CardArtToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\cards"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CosmeticArtToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\cosmetics"
          SkipUnchangedFiles="true" />
    <!-- Music tier trees: the revision segment is $(MusicAssetRevision),
         parsed from MusicAssets.cs above (impl-r4 K4). MakeDirs are
         conditioned on the item groups so a music-less checkout never plants
         empty tier dirs for MusicAssets to judge invalid. -->
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\music\$(MusicAssetRevision)\previews"
             Condition="'@(MusicPreviewsToCopy)' != ''" />
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\music\$(MusicAssetRevision)\full"
             Condition="'@(MusicFullToCopy)' != ''" />
    <Copy SourceFiles="@(MusicPreviewsToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\music\$(MusicAssetRevision)\previews"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MusicFullToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\music\$(MusicAssetRevision)\full"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MusicManifestToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\music\$(MusicAssetRevision)"
          SkipUnchangedFiles="true"
          Condition="'@(MusicManifestToCopy)' != ''" />
    <Message Text="Copied $(AssemblyName).dll to BepInEx plugins" Importance="high" />
    <Message Text="Copied comp-rounds-fonts bundle to BepInEx plugins" Importance="high"
             Condition="Exists('$(OutputPath)comp-rounds-fonts')" />
    <Message Text="Copied @(CardArtToCopy->Count()) card art files to BepInEx plugins" Importance="high" />
    <Message Text="Copied @(CosmeticArtToCopy->Count()) cosmetic art files to BepInEx plugins" Importance="high" />
    <Message Text="Copied @(MusicPreviewsToCopy->Count()) music preview files + @(MusicFullToCopy->Count()) full tracks to BepInEx plugins ($(MusicAssetRevision))"
             Importance="high"
             Condition="'@(MusicFullToCopy)' != ''" />
  </Target>

</Project>
