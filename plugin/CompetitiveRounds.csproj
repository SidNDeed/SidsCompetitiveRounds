<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CompetitiveRounds</AssemblyName>
    <RootNamespace>CompetitiveRounds</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0169;CS0649</NoWarn>
    <Configurations>Debug;Release;Thunderstore</Configurations>
    <!-- Deterministic, symbol-free output: BepInEx stack traces report IL
         offsets regardless (the pdb is never loaded at runtime), so shipped
         builds carry no debug artifacts. Do not change. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Thunderstore build: excludes auto-updater .bat at compile time -->
  <!-- Build with: dotnet build -c Thunderstore  (or select "Thunderstore" config in VS) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Thunderstore'">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RoundsDir>C:\Program Files (x86)\Steam\steamapps\common\ROUNDS</RoundsDir>
    <BepInExDir>$(RoundsDir)\BepInEx</BepInExDir>
    <ManagedDir>$(RoundsDir)\Rounds_Data\Managed</ManagedDir>
  </PropertyGroup>

  <!-- Krafs.Publicizer — exposes private members of referenced assemblies at compile time -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- BepInEx (still needed for plugin loading and logging) -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InControl">
      <!-- Needed because the InputDevice type appears in the signature of
           PlayerAssigner.CreatePlayer, which we Harmony-patch for 2v2. -->
      <HintPath>$(ManagedDir)\InControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity Post-Processing Stack v2 — used by the custom map color profiles
         (CustomMapColors.cs) so we can author ColorGrading effects at runtime
         without bundling pre-made PostProcessProfile assets. -->
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(ManagedDir)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game (publicized for direct access to private members) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <!-- Photon (publicized for direct access to private members) -->
  <ItemGroup>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="PhotonUnityNetworking" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="PhotonRealtime" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <!-- Steamworks -->
  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Auto-copy to plugins folder after build. The font bundle is optional — generated by
       the unity-font-bundler/ Unity project, written to the same OutputPath. If present we
       copy it alongside the DLL so NametagFontRenderer can load it via AssetBundle.LoadFromFile
       next to itself. If absent (user hasn't run the Font Bundler), the mod still loads;
       typefaces just silently fall back to the default font. -->
  <!-- Card art (jpg/png) — shipped alongside the DLL. CardImageLoader.cs
       reads these from <plugin-dir>/cards/ at runtime. The CardArtToCopy
       item group rebuilds on each build to pick up new files. -->
  <ItemGroup>
    <CardArtToCopy Include="cards\*.jpg" />
    <CardArtToCopy Include="cards\*.png" />
    <!-- Custom cosmetic art (512px transparent PNGs) — CustomCosmetics.cs reads
         these from <plugin-dir>/cosmetics/ at runtime (same pipeline as cards). -->
    <CosmeticArtToCopy Include="cosmetics\*.png" />
  </ItemGroup>

  <!-- Home-tab logo: EMBEDDED in the DLL (not a loose file) because the
       auto-updater ships the DLL alone — a beside-the-DLL asset would vanish
       for auto-updated installs. NativeUI resolves it by manifest-name suffix. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\logo.png" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds" />
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\cards" />
    <MakeDir Directories="$(BepInExDir)\plugins\CompetitiveRounds\cosmetics" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)comp-rounds-fonts"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)comp-rounds-fonts')" />
    <Copy SourceFiles="@(CardArtToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\cards"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CosmeticArtToCopy)"
          DestinationFolder="$(BepInExDir)\plugins\CompetitiveRounds\cosmetics"
          SkipUnchangedFiles="true" />
    <Message Text="Copied $(AssemblyName).dll to BepInEx plugins" Importance="high" />
    <Message Text="Copied comp-rounds-fonts bundle to BepInEx plugins" Importance="high"
             Condition="Exists('$(OutputPath)comp-rounds-fonts')" />
    <Message Text="Copied @(CardArtToCopy->Count()) card art files to BepInEx plugins" Importance="high" />
    <Message Text="Copied @(CosmeticArtToCopy->Count()) cosmetic art files to BepInEx plugins" Importance="high" />
  </Target>

</Project>
