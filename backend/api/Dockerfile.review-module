# The review module sandbox (backend/docker-compose.yml service
# `review-module`). The image holds ONLY the runner: no api code, no
# requirements, no secrets. The module itself is mounted read-only at run
# time and is never part of this build context's output.
FROM python:3.12-slim

COPY review_module_runner.py /runner/review_module_runner.py

# A container-readable file that no mount declares, readable by root only:
# the sandbox probe (`probe /probe/undeclared ...`) must find it unreadable
# under the service's unprivileged user.
RUN mkdir -p /probe && echo probe > /probe/undeclared \
    && chmod 0600 /probe/undeclared && chmod 0555 /runner

USER 65534:65534
# -I ignores every PYTHON* variable; -B writes no bytecode (the root is read-only).
ENTRYPOINT ["python", "-I", "-B", "/runner/review_module_runner.py"]
