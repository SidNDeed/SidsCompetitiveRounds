# ============================================================
# Competitive ROUNDS — Environment Configuration
# ============================================================
# Copy this file to .env and change ALL passwords before use.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=comp_rounds
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=competitive_rounds

# --- API Server (Phase 1) ---
API_PORT=8443
API_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING
MATCH_HMAC_SECRET=CHANGE_ME_THIS_SIGNS_MATCH_REPORTS

# --- Glicko-2 Tuning ---
# System volatility constant (tau). Lower = slower rating changes.
# 0.5 is a good starting point for a small competitive scene.
GLICKO2_TAU=0.5

# Rating period in hours. With 10-60 daily actives, weekly (168h)
# prevents wild swings from a single session.

# Default rating for new players (Glicko-2 standard is 1500)
GLICKO2_DEFAULT_RATING=1500
GLICKO2_DEFAULT_RD=350
GLICKO2_DEFAULT_VOLATILITY=0.06
